{
    // Four ways to start the service from the editor, and the tests.
    //
    // "readerboard and the sign simulator" is the one to reach for. It runs
    // both, with the service already pointed at the simulator, so every
    // transmission it makes is decoded in a window beside it. Everything it
    // needs is set by scripts/run_with_simulator.py rather than here, so this
    // file and the command line cannot drift apart, and the same is true of the
    // matching PyCharm configuration in .idea/runConfigurations/, which carries
    // the same name.
    //
    // "readerboard, the sign simulator and the client" is that same script
    // with --with-client, which adds the client pointed at the service, so the
    // whole loop comes up at once. The client asks for the API key itself
    // rather than taking one from a command line, so the key in use is printed
    // for pasting, and starting it this way replaces the base URL it remembers
    // between runs. Closing the client leaves the other two running; closing
    // either of those stops the rest.
    //
    // "readerboard against the loopback" needs no hardware either: loop:// is
    // pyserial's loopback, so the service starts, serves /docs, and accepts
    // writes that go nowhere. Use it when the API itself is the thing being
    // worked on and there is no reason to look at the bytes. It restarts on a
    // source change. It runs the service's own entry point rather than uvicorn
    // directly, which is what the PyCharm configuration of the same name does,
    // so both read the settings the same way and both honour the variable
    // below; uvicorn started by hand reads none of them.
    //
    // "readerboard against the real sign" reads the config file like the
    // installed service does. Point READERBOARD_CONFIG_FILE at a copy you keep
    // locally.
    //
    // Every configuration that starts the service sets READERBOARD_OPEN_DOCS,
    // which opens the documentation page once the port answers. The service
    // does the waiting and the opening, so it uses the address it actually
    // bound rather than one repeated here, which matters for the real sign
    // below: its port comes from a config file this knows nothing about. It is
    // off by default, so an installed service on a Pi opens nothing. Drop the
    // variable from a configuration to stop it, or set it to 0.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "readerboard and the sign simulator",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_with_simulator.py",
            "console": "integratedTerminal",
            "env": {
                "READERBOARD_OPEN_DOCS": "1"
            },
            "justMyCode": false
        },
        {
            "name": "readerboard, the sign simulator and the client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_with_simulator.py",
            "args": [
                "--with-client"
            ],
            "console": "integratedTerminal",
            "env": {
                "READERBOARD_OPEN_DOCS": "1"
            },
            "justMyCode": false
        },
        {
            "name": "readerboard against the loopback",
            "type": "debugpy",
            "request": "launch",
            "module": "readerboard",
            "args": [
                "--reload",
                "--port",
                "5001"
            ],
            "env": {
                "READERBOARD_SERIAL_URL": "loop://",
                "READERBOARD_API_KEY": "local-development-key",
                "READERBOARD_STATE_PATH": "${workspaceFolder}/.local-state.json",
                "READERBOARD_LOG_LEVEL": "DEBUG",
                "READERBOARD_CLOCK_SYNC_ENABLED": "false",
                "READERBOARD_OPEN_DOCS": "1"
            },
            "justMyCode": false
        },
        {
            "name": "readerboard against the real sign",
            "type": "debugpy",
            "request": "launch",
            "module": "readerboard",
            "env": {
                "READERBOARD_CONFIG_FILE": "${workspaceFolder}/config.local.toml",
                "READERBOARD_LOG_LEVEL": "DEBUG",
                "READERBOARD_OPEN_DOCS": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v"
            ],
            "justMyCode": false
        }
    ]
}
