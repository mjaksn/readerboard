{
  "components": {
    "schemas": {
      "AlertRequest": {
        "additionalProperties": false,
        "description": "A message that takes the whole sign over until it is released.",
        "properties": {
          "display_mode": {
            "default": "HOLD",
            "description": "how the sign presents the alert",
            "title": "Display Mode",
            "type": "string"
          },
          "message": {
            "description": "the alert text. The sign's priority file holds 125 bytes once markup has been rendered, and cannot be resized",
            "maxLength": 4096,
            "title": "Message",
            "type": "string"
          },
          "position": {
            "default": "MIDDLE",
            "description": "where the text sits vertically",
            "title": "Position",
            "type": "string"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "release the sign this many seconds from now. Omit and the alert holds the sign until something releases it explicitly",
            "title": "Ttl Seconds"
          }
        },
        "required": [
          "message"
        ],
        "title": "AlertRequest",
        "type": "object"
      },
      "AlertResponse": {
        "description": "The alert currently holding the sign.",
        "properties": {
          "display_mode": {
            "title": "Display Mode",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "message",
          "display_mode",
          "position",
          "started_at",
          "expires_at"
        ],
        "title": "AlertResponse",
        "type": "object"
      },
      "ClockResponse": {
        "description": "The result of setting the sign's clock.",
        "properties": {
          "synced_at": {
            "description": "the time the sign was told, in its configured zone",
            "format": "date-time",
            "title": "Synced At",
            "type": "string"
          }
        },
        "required": [
          "synced_at"
        ],
        "title": "ClockResponse",
        "type": "object"
      },
      "ControlCommandRequest": {
        "additionalProperties": false,
        "description": "A command aimed at the sign itself rather than at a message.",
        "properties": {
          "command": {
            "description": "one of SET_DAY_OF_WEEK, SET_TIME, SET_TIME_FORMAT",
            "title": "Command",
            "type": "string"
          },
          "parameter": {
            "default": "",
            "description": "the command's parameter, if it takes one",
            "title": "Parameter",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "title": "ControlCommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "What the service knows about itself. Requires no API key.",
        "properties": {
          "alert_active": {
            "title": "Alert Active",
            "type": "boolean"
          },
          "clock_last_synced_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clock Last Synced At"
          },
          "link": {
            "$ref": "#/components/schemas/LinkHealth"
          },
          "sign_in_sync": {
            "description": "false when a registered message has been accepted but not yet written to the sign, which is what a write during an outage looks like",
            "title": "Sign In Sync",
            "type": "boolean"
          },
          "slots_total": {
            "title": "Slots Total",
            "type": "integer"
          },
          "slots_used": {
            "title": "Slots Used",
            "type": "integer"
          },
          "status": {
            "description": "'ok' when the sign is reachable, otherwise 'degraded'",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "link",
          "slots_used",
          "slots_total",
          "sign_in_sync",
          "alert_active",
          "clock_last_synced_at"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LinkHealth": {
        "description": "The state of the link to the sign.",
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_write_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Write At"
          },
          "suppressed_writes": {
            "description": "writes skipped because the sign already held those exact bytes",
            "title": "Suppressed Writes",
            "type": "integer"
          },
          "url": {
            "description": "the configured pyserial URL",
            "title": "Url",
            "type": "string"
          },
          "writes": {
            "title": "Writes",
            "type": "integer"
          }
        },
        "required": [
          "url",
          "connected",
          "last_write_at",
          "last_error",
          "writes",
          "suppressed_writes"
        ],
        "title": "LinkHealth",
        "type": "object"
      },
      "MessageRequest": {
        "additionalProperties": false,
        "description": "A message registered into a slot.",
        "properties": {
          "display_mode": {
            "default": "HOLD",
            "description": "how the sign presents the message",
            "title": "Display Mode",
            "type": "string"
          },
          "message": {
            "description": "the message, including markup tokens such as <red> and <degree>",
            "maxLength": 4096,
            "title": "Message",
            "type": "string"
          },
          "order": {
            "default": 0,
            "description": "lower numbers play earlier in the rotation; ties break on the slot name",
            "title": "Order",
            "type": "integer"
          },
          "position": {
            "default": "MIDDLE",
            "description": "where the text sits vertically",
            "title": "Position",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "who registered this, recorded so the slot list is readable",
            "title": "Source"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "drop the message this many seconds from now; omit to keep it until replaced",
            "title": "Ttl Seconds"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageRequest",
        "type": "object"
      },
      "SimpleCommandRequest": {
        "description": "The body POST /Write/ControlCommand has always accepted.",
        "properties": {
          "command": {
            "description": "the control command to send to the sign",
            "title": "Command",
            "type": "string"
          },
          "parameter": {
            "default": "",
            "description": "a parameter for the command",
            "title": "Parameter",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "title": "SimpleCommandRequest",
        "type": "object"
      },
      "SimpleControlCommand": {
        "description": "One entry of GET /Enumerations/ControlCommands.",
        "properties": {
          "control_command": {
            "title": "Control Command",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "control_command",
          "description"
        ],
        "title": "SimpleControlCommand",
        "type": "object"
      },
      "SimpleDisplayMode": {
        "description": "One entry of GET /Enumerations/DisplayModes.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_mode": {
            "title": "Display Mode",
            "type": "string"
          }
        },
        "required": [
          "display_mode",
          "description"
        ],
        "title": "SimpleDisplayMode",
        "type": "object"
      },
      "SimpleMessageRequest": {
        "description": "The body POST /Write/Message has always accepted.",
        "properties": {
          "display_mode": {
            "description": "the display mode to use when showing the message",
            "title": "Display Mode",
            "type": "string"
          },
          "message": {
            "description": "the message, including markup tokens, to display on the sign",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "display_mode",
          "message"
        ],
        "title": "SimpleMessageRequest",
        "type": "object"
      },
      "SimpleResult": {
        "description": "The body the old endpoints have always returned, whatever happened.",
        "properties": {
          "result": {
            "description": "OK or ERROR",
            "title": "Result",
            "type": "string"
          },
          "result_message": {
            "description": "text description of the command result",
            "title": "Result Message",
            "type": "string"
          }
        },
        "required": [
          "result",
          "result_message"
        ],
        "title": "SimpleResult",
        "type": "object"
      },
      "SimpleToken": {
        "description": "One entry of GET /Enumerations/MarkupTokens.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "token_text": {
            "title": "Token Text",
            "type": "string"
          }
        },
        "required": [
          "token_text",
          "description"
        ],
        "title": "SimpleToken",
        "type": "object"
      },
      "SlotResponse": {
        "description": "A registered slot.",
        "properties": {
          "display_mode": {
            "title": "Display Mode",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "description": "the sign file this slot occupies, A through Z",
            "title": "Label",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "position": {
            "title": "Position",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "message",
          "display_mode",
          "position",
          "order",
          "source",
          "expires_at",
          "updated_at"
        ],
        "title": "SlotResponse",
        "type": "object"
      },
      "TokenInfo": {
        "description": "One entry in an enumeration.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "title": "TokenInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nDrives a BetaBrite Classic sign over the Alpha protocol, either through a serial\ncable or through an Ethernet to RS-232 adapter.\n\nSeveral sources can share the sign at once. Each registers a named **slot**, and\nthe sign rotates through the registered slots by itself. An **alert** takes the\nwhole display over until it is released, then the rotation resumes.\n\nEvery write needs an `X-API-Key` header. `GET /health` does not.\n\nThe `/Write` and `/Enumerations` paths are a smaller surface for clients that\nwould rather not read status codes: every response there is a 200 with the\noutcome in the body.\n",
    "title": "readerboard",
    "version": "0.1.2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/Enumerations/ControlCommands": {
      "get": {
        "description": "List the control commands, in the old shape.",
        "operationId": "control_commands_Enumerations_ControlCommands_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SimpleControlCommand"
                  },
                  "title": "Response Control Commands Enumerations Controlcommands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Available control commands",
        "tags": [
          "Enumerations (simple)"
        ]
      }
    },
    "/Enumerations/DisplayModes": {
      "get": {
        "description": "List the display modes, in the old shape.",
        "operationId": "display_modes_Enumerations_DisplayModes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SimpleDisplayMode"
                  },
                  "title": "Response Display Modes Enumerations Displaymodes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Available display modes",
        "tags": [
          "Enumerations (simple)"
        ]
      }
    },
    "/Enumerations/MarkupTokens": {
      "get": {
        "description": "List the markup tokens, in the old shape.\n\n``token_text`` is the token to write in a message, such as ``<red>``, and\n``description`` says what it does. Easy to describe the wrong way round,\nwhich is why they are spelled out here.",
        "operationId": "markup_tokens_Enumerations_MarkupTokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SimpleToken"
                  },
                  "title": "Response Markup Tokens Enumerations Markuptokens Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Available markup tokens",
        "tags": [
          "Enumerations (simple)"
        ]
      }
    },
    "/Write/ControlCommand": {
      "post": {
        "description": "Send one of the sign's control commands.",
        "operationId": "write_control_command_Write_ControlCommand_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimpleCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send a control command to the sign",
        "tags": [
          "Write (simple)"
        ]
      }
    },
    "/Write/Message": {
      "post": {
        "description": "Display a message on the sign.\n\nThe message goes into a reserved slot rather than the sign's priority file,\nso other sources can share the sign with it.",
        "operationId": "write_message_Write_Message_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimpleMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Write a message to the sign",
        "tags": [
          "Write (simple)"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report the state of the link, the slots, and the clock.\n\nDeliberately unauthenticated, so that a monitor can watch the sign\nwithout holding a key that could write to it.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Is the service talking to the sign",
        "tags": [
          "Health"
        ]
      }
    },
    "/v2/alerts": {
      "delete": {
        "description": "Release an alert so the rotation resumes.",
        "operationId": "delete_alert_v2_alerts_delete",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Give the sign back",
        "tags": [
          "Alerts"
        ]
      },
      "get": {
        "description": "Return the active alert, or null if the sign is rotating normally.",
        "operationId": "get_alert_v2_alerts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AlertResponse"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Alert V2 Alerts Get"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read the alert holding the sign",
        "tags": [
          "Alerts"
        ]
      },
      "post": {
        "description": "Take the whole sign over until the alert is released.\n\nThis uses the sign's priority file, which suppresses every other message. If\na ttl is given, the sign is released automatically and the rotation resumes\nby itself.",
        "operationId": "post_alert_v2_alerts_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Take the sign over with an alert",
        "tags": [
          "Alerts"
        ]
      }
    },
    "/v2/enumerations/control-commands": {
      "get": {
        "description": "List every control command.",
        "operationId": "control_commands_v2_enumerations_control_commands_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Control Commands V2 Enumerations Control Commands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Commands aimed at the sign itself",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/v2/enumerations/display-modes": {
      "get": {
        "description": "List every display mode.",
        "operationId": "display_modes_v2_enumerations_display_modes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Display Modes V2 Enumerations Display Modes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ways the sign can present a message",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/v2/enumerations/markup-tokens": {
      "get": {
        "description": "List every token that can be written inline in a message.",
        "operationId": "markup_tokens_v2_enumerations_markup_tokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
