{
  "components": {
    "schemas": {
      "AlertRequest": {
        "additionalProperties": false,
        "description": "A message that takes the whole sign over until it is released.",
        "properties": {
          "display_mode": {
            "default": "HOLD",
            "description": "how the sign presents the alert",
            "title": "Display Mode",
            "type": "string"
          },
          "message": {
            "description": "the alert text. The sign's priority file holds 125 bytes once markup has been rendered, and cannot be resized",
            "maxLength": 4096,
            "title": "Message",
            "type": "string"
          },
          "position": {
            "default": "MIDDLE",
            "description": "where the text sits vertically",
            "title": "Position",
            "type": "string"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "release the sign this many seconds from now. Omit and the alert holds the sign until something releases it explicitly",
            "title": "Ttl Seconds"
          }
        },
        "required": [
          "message"
        ],
        "title": "AlertRequest",
        "type": "object"
      },
      "AlertResponse": {
        "description": "The alert currently holding the sign.",
        "properties": {
          "display_mode": {
            "title": "Display Mode",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "message",
          "display_mode",
          "position",
          "started_at",
          "expires_at"
        ],
        "title": "AlertResponse",
        "type": "object"
      },
      "ClockResponse": {
        "description": "The result of setting the sign's clock.",
        "properties": {
          "synced_at": {
            "description": "the time the sign was told, in its configured zone",
            "format": "date-time",
            "title": "Synced At",
            "type": "string"
          }
        },
        "required": [
          "synced_at"
        ],
        "title": "ClockResponse",
        "type": "object"
      },
      "ControlCommandRequest": {
        "additionalProperties": false,
        "description": "A command aimed at the sign itself rather than at a message.",
        "properties": {
          "command": {
            "description": "one of SET_DAY_OF_WEEK, SET_TIME, SET_TIME_FORMAT",
            "title": "Command",
            "type": "string"
          },
          "parameter": {
            "default": "",
            "description": "the command's parameter, if it takes one",
            "title": "Parameter",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "title": "ControlCommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "What the service knows about itself. Requires no API key.",
        "properties": {
          "alert_active": {
            "title": "Alert Active",
            "type": "boolean"
          },
          "clock_last_synced_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clock Last Synced At"
          },
          "link": {
            "$ref": "#/components/schemas/LinkHealth"
          },
          "sign_in_sync": {
            "description": "false when a registered message has been accepted but not yet written to the sign, which is what a write during an outage looks like",
            "title": "Sign In Sync",
            "type": "boolean"
          },
          "slots_total": {
            "title": "Slots Total",
            "type": "integer"
          },
          "slots_used": {
            "title": "Slots Used",
            "type": "integer"
          },
          "status": {
            "description": "'ok' when the sign is reachable, otherwise 'degraded'",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "link",
          "slots_used",
          "slots_total",
          "sign_in_sync",
          "alert_active",
          "clock_last_synced_at"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LinkHealth": {
        "description": "The state of the link to the sign.",
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_write_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Write At"
          },
          "suppressed_writes": {
            "description": "writes skipped because the sign already held those exact bytes",
            "title": "Suppressed Writes",
            "type": "integer"
          },
          "url": {
            "description": "the configured pyserial URL",
            "title": "Url",
            "type": "string"
          },
          "writes": {
            "title": "Writes",
            "type": "integer"
          }
        },
        "required": [
          "url",
          "connected",
          "last_write_at",
          "last_error",
          "writes",
          "suppressed_writes"
        ],
        "title": "LinkHealth",
        "type": "object"
      },
      "MessageRequest": {
        "additionalProperties": false,
        "description": "A message registered into a slot.",
        "properties": {
          "display_mode": {
            "default": "HOLD",
            "description": "how the sign presents the message",
            "title": "Display Mode",
            "type": "string"
          },
          "message": {
            "description": "the message, including markup tokens such as <red> and <degree>",
            "maxLength": 4096,
            "title": "Message",
            "type": "string"
          },
          "order": {
            "default": 0,
            "description": "lower numbers play earlier in the rotation; ties break on the slot name",
            "title": "Order",
            "type": "integer"
          },
          "position": {
            "default": "MIDDLE",
            "description": "where the text sits vertically",
            "title": "Position",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "who registered this, recorded so the slot list is readable",
            "title": "Source"
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "drop the message this many seconds from now; omit to keep it until replaced",
            "title": "Ttl Seconds"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageRequest",
        "type": "object"
      },
      "SlotResponse": {
        "description": "A registered slot.",
        "properties": {
          "display_mode": {
            "title": "Display Mode",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "description": "the sign file this slot occupies, A through Z",
            "title": "Label",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "order": {
            "title": "Order",
            "type": "integer"
          },
          "position": {
            "title": "Position",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "message",
          "display_mode",
          "position",
          "order",
          "source",
          "expires_at",
          "updated_at"
        ],
        "title": "SlotResponse",
        "type": "object"
      },
      "TokenInfo": {
        "description": "One entry in an enumeration.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "title": "TokenInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "The shared key every write carries. Set it with `api_key` in the config file or `READERBOARD_API_KEY` in the environment; `scripts/install.sh` generates one.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "\nDrives a BetaBrite Classic sign over the Alpha protocol, either through a serial\ncable or through an Ethernet to RS-232 adapter.\n\nSeveral sources can share the sign at once. Each registers a named **slot**, and\nthe sign rotates through the registered slots by itself. An **alert** takes the\nwhole display over until it is released, then the rotation resumes.\n\nEvery write needs an `X-API-Key` header. Reads and `GET /health` do not. On this\npage, put the key in once with the **Authorize** button and every write below\ncarries it.\n\nA failure is reported by the status code, with the reason in a `detail` field:\n400 for a command the sign does not have, a parameter it will not accept, a\nmessage too long for its slot or markup the sign cannot render, 401 for a\nmissing or wrong `X-API-Key`, 404 for a slot nothing has registered, 409 when\nevery message slot is already in use, 503 when the sign is unreachable or no\nAPI key is configured at all, 500 for something the service has no code for,\nand 422 for a body that is not the shape the endpoint declares, which includes\na display mode or a text position the sign does not have.\n",
    "title": "readerboard",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/alerts": {
      "delete": {
        "description": "Release an alert so the rotation resumes.",
        "operationId": "delete_alert_alerts_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Give the sign back",
        "tags": [
          "Alerts"
        ]
      },
      "get": {
        "description": "Return the active alert, or null if the sign is rotating normally.",
        "operationId": "get_alert_alerts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AlertResponse"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Alert Alerts Get"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read the alert holding the sign",
        "tags": [
          "Alerts"
        ]
      },
      "post": {
        "description": "Take the whole sign over until the alert is released.\n\nThis uses the sign's priority file, which suppresses every other message. If\na ttl is given, the sign is released automatically and the rotation resumes\nby itself.",
        "operationId": "post_alert_alerts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Take the sign over with an alert",
        "tags": [
          "Alerts"
        ]
      }
    },
    "/enumerations/control-commands": {
      "get": {
        "description": "List every control command.",
        "operationId": "control_commands_enumerations_control_commands_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Control Commands Enumerations Control Commands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Commands aimed at the sign itself",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/enumerations/display-modes": {
      "get": {
        "description": "List every display mode.",
        "operationId": "display_modes_enumerations_display_modes_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Display Modes Enumerations Display Modes Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ways the sign can present a message",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/enumerations/markup-tokens": {
      "get": {
        "description": "List every token that can be written inline in a message.",
        "operationId": "markup_tokens_enumerations_markup_tokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Markup Tokens Enumerations Markup Tokens Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Markup tokens a message may contain",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/enumerations/text-positions": {
      "get": {
        "description": "List every vertical text position.",
        "operationId": "text_positions_enumerations_text_positions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Text Positions Enumerations Text Positions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Where text sits vertically",
        "tags": [
          "Enumerations"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report the state of the link, the slots, and the clock.\n\nDeliberately unauthenticated, so that a monitor can watch the sign\nwithout holding a key that could write to it.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Is the service talking to the sign",
        "tags": [
          "Health"
        ]
      }
    },
    "/messages": {
      "delete": {
        "description": "Remove every slot, leaving the sign showing nothing.",
        "operationId": "clear_messages_messages_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Take every message off the sign",
        "tags": [
          "Messages"
        ]
      },
      "get": {
        "description": "Return every registered slot, in the order the sign plays them.",
        "operationId": "list_messages_messages_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SlotResponse"
                  },
                  "title": "Response List Messages Messages Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the messages sharing the sign",
        "tags": [
          "Messages"
        ]
      }
    },
    "/messages/{key}": {
      "delete": {
        "description": "Remove one slot and free the sign file it held.",
        "operationId": "delete_message_messages__key__delete",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "description": "the name of the slot, chosen by whoever owns it",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Take a message off the sign",
        "tags": [
          "Messages"
        ]
      },
      "get": {
        "description": "Return one slot by name.",
        "operationId": "get_message_messages__key__get",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "description": "the name of the slot, chosen by whoever owns it",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read one message",
        "tags": [
          "Messages"
        ]
      },
      "put": {
        "description": "Put a message in a slot, replacing whatever was there.\n\nThe sign rotates through every registered slot on its own, so registering a\nsecond message does not displace the first.",
        "operationId": "put_message_messages__key__put",
        "parameters": [
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "description": "the name of the slot, chosen by whoever owns it",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "title": "Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Register or replace a message",
        "tags": [
          "Messages"
        ]
      }
    },
    "/sign/command": {
