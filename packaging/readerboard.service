[Unit]
Description=readerboard, a BetaBrite sign driver
Documentation=https://github.com/mjaksn/readerboard
# The sign is normally reached over the network, through an Ethernet to RS-232
# adapter, so wait for a routable address rather than merely for the stack.
After=network-online.target
Wants=network-online.target

# Stop retrying after ten failed starts in five minutes, which at the five
# second RestartSec below is under a minute of trying. Almost everything that
# goes wrong here is transient and Restart=always is what handles it: the
# service starts with the sign unplugged, reconnects on its own, and comes up
# even with an unreadable state file. What is left is the handful of failures
# that will fail identically for ever, a memory pool too big for the sign being
# one, and those are worth giving up on: each attempt puts a read on the wire,
# which stalls a scrolling message for about half a second, so a loop that never
# ends is a sign that twitches every five seconds until somebody logs in. It
# needs a person either way. `systemctl reset-failed readerboard` clears it once
# the configuration is fixed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=readerboard
Group=readerboard
Environment=READERBOARD_CONFIG_FILE=/etc/readerboard/config.toml
ExecStart=/opt/readerboard/venv/bin/readerboard
Restart=always
RestartSec=5

# systemd creates /var/lib/readerboard and gives it to the service user. The
# registry is persisted there, which is what lets the sign come back after a
# restart without every source having to write to it again.
StateDirectory=readerboard
StateDirectoryMode=0750

# Logs go to stderr, which journald collects.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=readerboard

# Hardening. The service reads one config file, writes one state directory, and
# talks to one sign. It needs nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_INET and AF_INET6 for the HTTP listener and for a socket:// sign;
# AF_UNIX because the Python runtime uses it internally.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# For a sign on a cable rather than on the network, uncomment both of these.
# The first lets the service read /dev/ttyUSB0 and friends; the second is the
# group that owns them on Debian and Raspberry Pi OS. PrivateDevices is left
# off by default rather than on, because turning it on would hide exactly the
# device a directly connected sign lives at.
#DeviceAllow=char-ttyUSB rw
#SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
